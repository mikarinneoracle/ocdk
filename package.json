{
  "name": "@mikarinneoracle/oci-cdk",
  "version": "1.4.4",
  "description": "OCI CDK stack for OCI Functions, API Gateway, and related infrastructure",
  "main": "lib/index.js",
  "bin": {
    "ocdk": "./bin/ocdk.js"
  },
  "scripts": {
    "build": "node bin/build-if-needed.js",
    "compile": "tsc",
    "watch": "tsc -w",
    "test": "npm run test:code-only",
    "test:code-only": "node scripts/test-code-only-archive.js",
    "ocdk": "node bin/ocdk.js",
    "cdktf": "cdktf",
    "deploy": "cdktf deploy",
    "diff": "cdktf diff",
    "destroy": "cdktf destroy",
    "get": "cdktf get",
    "synth": "cdktf synth",
    "list": "cdktf list",
    "prepublishOnly": "npm run get && npm run compile && npm run build && node bin/verify-publish.js"
  },
  "keywords": [
    "oci",
    "cdk",
    "terraform",
    "infrastructure-as-code"
  ],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikarinneoracle/ocdk.git"
  },
  "bugs": {
    "url": "https://github.com/mikarinneoracle/ocdk/issues"
  },
  "homepage": "https://github.com/mikarinneoracle/ocdk#readme",
  "files": [
    "README.md",
    "bin",
    "lib",
    ".gen",
    "scripts",
    "cdktf.json",
    "ocdk.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "cdktf": "^0.21.0",
    "cdktf-cli": "^0.21.0",
    "constructs": "^10.0.0",
    "oci-common": "2.142.1",
    "oci-logging": "2.142.1",
    "oci-loggingsearch": "2.142.1",
    "oci-objectstorage": "2.142.1"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0"
  }
}
